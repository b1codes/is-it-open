{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TomTom Search API v2: geocode",
  "description": "The parts of TomTom's response that TomTomClient.geocode_address reads. Other fields TomTom sends are allowed. See contracts/README.md.",
  "type": "object",
  "required": [
    "summary",
    "results"
  ],
  "properties": {
    "summary": {
      "type": "object"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "position"
        ],
        "properties": {
          "position": {
            "type": "object",
            "required": [
              "lat",
              "lon"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            }
          }
        }
      }
    }
  }
}
