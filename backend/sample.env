# Required Secrets
SECRET_KEY=generate-a-secure-secret-key-here
TOMTOM_API_KEY=your-tomtom-key

# Production Settings
DEBUG=0
ALLOWED_HOSTS=yourdomain.com,your-ec2-ip

# Google Cloud Firestore
# Local dev: docker-compose.yml points the backend at the emulator in docker/firestore-emulator.
# Running the backend outside Docker? Use FIRESTORE_EMULATOR_HOST=localhost:8080.
GOOGLE_CLOUD_PROJECT=demo-is-it-open
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIRESTORE_DATABASE=(default)
# Production (docker-compose.prod.yml): path to a service account key on the host
# GCP_CREDENTIALS_FILE=./backend/gcp-service-account.json

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=http://your-frontend-domain.com

# Auth0 Configuration
AUTH0_DOMAIN=your-auth0-domain.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier/api
AUTH0_MOCK=True
