# Copy to backend/.env. In production, docker-compose.prod.yml passes this file to the container
# (env_file), and it is the only place the backend's settings come from. See README_DEPLOY.md.

# Required Secrets
SECRET_KEY=generate-a-secure-secret-key-here
TOMTOM_API_KEY=your-tomtom-key

# Production Settings
DEBUG=0
ALLOWED_HOSTS=yourdomain.com,your-ec2-ip

# Google Cloud Firestore
# Production: your GCP project ID (required; the container won't start with an empty or demo-* value).
# Local dev: docker-compose.yml ignores this file and uses the emulator in docker/firestore-emulator.
# Running the backend outside Docker? Use GOOGLE_CLOUD_PROJECT=demo-is-it-open and
# FIRESTORE_EMULATOR_HOST=localhost:8080.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Only for a named (non-default) database. Leave the line out otherwise; an empty value is rejected.
# FIRESTORE_DATABASE=(default)
# FIRESTORE_EMULATOR_HOST=localhost:8080
#
# Credentials use Application Default Credentials: nothing to set on Google Cloud. Elsewhere, mount a
# key with docker-compose.prod.keyfile.yml. Its GCP_CREDENTIALS_FILE host path is a Compose variable
# (export it in your shell); it has no effect here.

# CORS Settings
# CORS_ALLOWED_ORIGINS isn't read by settings.py yet: with CORS_ALLOW_ALL_ORIGINS=0, browsers on other
# origins (e.g. a Flutter web build) are refused. Mobile apps are unaffected.
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=http://your-frontend-domain.com

# Auth0 Configuration
# AUTH0_MOCK=1 accepts unsigned tokens, so it only works with DEBUG=1 (local development). Off, Auth0
# tokens are verified against AUTH0_DOMAIN; without a domain, every Auth0 token is rejected.
AUTH0_DOMAIN=your-auth0-domain.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier/api
AUTH0_MOCK=0
