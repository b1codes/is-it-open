# The backend's settings in the E2E stack, shared by docker-compose.e2e.yml and e2e/start-native.sh.
# Each adds where the emulator and the stub are (FIRESTORE_EMULATOR_HOST, TOMTOM_BASE_URL).
DEBUG=0
SECRET_KEY=e2e-only-not-secret
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=1
GOOGLE_CLOUD_PROJECT=demo-is-it-open-e2e
TOMTOM_API_KEY=e2e-stub-key
# The journeys sign in with username and password. There's no Auth0 tenant, so every Auth0 token
# is rejected (401) without a JWKS lookup: AUTH0_MOCK stays off here too. (A domain that doesn't
# resolve would answer 503 instead, since the keys couldn't be fetched, and the app would keep its
# session.) Set empty, rather than left out, so a developer's backend/.env can't fill them in.
AUTH0_MOCK=0
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
