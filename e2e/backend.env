# The backend's settings in the E2E stack, shared by docker-compose.e2e.yml and e2e/start-native.sh.
# Each adds where the emulator and the stub are (FIRESTORE_EMULATOR_HOST, TOMTOM_BASE_URL).
DEBUG=0
SECRET_KEY=e2e-only-not-secret
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=1
GOOGLE_CLOUD_PROJECT=demo-is-it-open-e2e
TOMTOM_API_KEY=e2e-stub-key
# The journeys sign in with username and password. Auth0 tokens are verified against a domain
# that doesn't resolve, so they're all rejected: AUTH0_MOCK stays off here too.
AUTH0_MOCK=0
AUTH0_DOMAIN=auth0.invalid
AUTH0_AUDIENCE=https://is-it-open.invalid/api
